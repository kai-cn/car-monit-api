# =============================================================================
# 本地联调环境变量示例 —— 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
#
# 禁止把真实口令、密钥、内部地址提交到仓库；这里全部是占位值。
# =============================================================================

# PostgreSQL 初始化口令（compose 首次创建数据卷时生效）
CM_PG_PASSWORD=change-me-local

# Grafana 管理员口令（仅 observability profile 使用）
GRAFANA_ADMIN_PASSWORD=change-me-local

# 可选：镜像 tag 覆盖
CAR_MONIT_API_IMAGE=car-monit-api:local

# 可选：镜像 OCI 标签（本地构建默认 dev/unknown）
CAR_MONIT_API_VERSION=dev
CAR_MONIT_API_GIT_SHA=unknown
