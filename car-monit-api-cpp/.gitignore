# 运行产物与可能含凭据的本地文件（不要入库）

# 构建产物
/build/
build*/
cmake-build-*/

# 日志（可能包含连接串/账号信息）
/logs/
*.log

# 本地覆盖配置：可以把真实口令写在这里，但不入库。
# 仓库内的 configs/config.yaml 已改成 ${CM_PG_PASSWORD} 环境变量占位。
configs/*.local.yaml
configs/*.local.yml
configs/config.local.yaml
configs/*.bak
configs/*.secret

# 环境变量文件（.env.example 是占位模板，允许入库）
.env
.env.*
!.env.example

# 控制台重定向产物（同上，可能含连接串）
run.out
run.err

# 契约采集结果可能包含真实业务数据/凭据，不入库
contracts/captured/
