# ============================================================================
# car-monit-api — 环境变量模板 / environment template
#
# ！！！重要！！！
# 本项目**不会**自动加载本文件（Java 侧没有 dotenv 机制，Python 侧也不引入）。
# 这只是"可覆盖哪些环境变量"的清单，请按需在 shell 里 export / set：
#
#   Windows :  set APP_SCHEDULER_ENABLED=false && python run.py
#   Linux   :  APP_SCHEDULER_ENABLED=false python run.py
#
# 真正的业务配置在 pro-business-api/src/main/resources/application.yml，
# 该文件**原样保留**且由 org/springframework/core/env/Environment.py 读取。
# ============================================================================

# ---------------------------------------------------------------------------
# 1) 宿主层（Python 独有，Java 侧无对应）
# ---------------------------------------------------------------------------
# uvicorn 绑定地址（= Tomcat 的 address，默认全网卡）
#CAR_MONIT_HOST=0.0.0.0

# uvicorn 端口；不设置时读 application.yml 的 server.port (9901)
#CAR_MONIT_PORT=9901

# 热重载，等价 spring-boot-devtools。只监听 app/ 目录，生产禁用。
#CAR_MONIT_RELOAD=false

# 日志级别 DEBUG / INFO / WARNING / ERROR
#CAR_MONIT_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 2) Spring 配置覆盖（Spring 松弛绑定：a.b-c -> A_B_C）
#
#    这里写的每个变量都会**优先于** application.yml 生效，
#    与 Spring 的 SystemEnvironmentPropertySource 行为完全一致。
# ---------------------------------------------------------------------------

# 关掉 10 个 @Scheduled 任务（对应 application.yml 的 app.scheduler.enabled）
# 注意：这个是 Python 侧新增的开关键，Java 侧无对应配置项
#APP_SCHEDULER_ENABLED=true

# 数据库（对应 spring.datasource.dynamic.datasource.master.*）
#SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_URL=jdbc:postgresql://192.168.56.10:5432/RuoYi
#SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_USERNAME=gaussdb
#SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_PASSWORD=changeme

# 连接池（对应 spring.datasource.dynamic.druid.*）
#SPRING_DATASOURCE_DYNAMIC_DRUID_MAXACTIVE=20
#SPRING_DATASOURCE_DYNAMIC_DRUID_MAXWAIT=60000

# 服务端口（对应 server.port，优先级低于 CAR_MONIT_PORT）
#SERVER_PORT=9901

# Redis（仅影响 /health 展示；无真实连接）
#SPRING_REDIS_HOST=127.0.0.1
#SPRING_REDIS_PORT=6379

# Elasticsearch（仅影响 /health 展示；无真实连接）
#ELASTICSEARCH_HOST=localhost
#ELASTICSEARCH_PORT=9200

# Kafka（仅影响 /health 展示；无真实连接）
#SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 导出目录（对应 optimization.export.dir）
#OPTIMIZATION_EXPORT_DIR=D:/data/export

# 部署标记（local / prod）
#ISLOCALHOST=local

# 一致性核对任务开关（对应 consistency.reconcile.enabled）
#CONSISTENCY_RECONCILE_ENABLED=false
