# car-monit-api-rust 环境变量（优先级：命令行 > 环境变量 > config/application.yaml > 代码默认值）
# 对应 Java: application.yml / application-optimization.yml

# ---- 服务 ----
APP_SERVER_PORT=9901
APP_SERVER_CONTEXT_PATH=/
RUST_LOG=info

# ---- GaussDB / PostgreSQL ----
APP_SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_URL=jdbc:postgresql://192.168.56.10:5432/RuoYi?characterEncoding=UTF-8&useUnicode=true&useSSL=false&serverTimezone=Asia/Shanghai
APP_SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_USERNAME=gaussdb
APP_SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_PASSWORD=<与 pro-business-api/src/main/resources/application.yml 一致>
APP_SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_MAX_OPEN_CONNS=20
APP_SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_MAX_IDLE_CONNS=5
APP_SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_LOG_SQL=false

# ---- Redis ----
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DATABASE=0

# ---- Kafka ----
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_GROUP_ID=ods-rt-szdn-snapshot-flow-sub
APP_KAFKA_TOPIC_SNAPSHOT_FLOW=ods-rt-szdn-snapshot-flow

# ---- Elasticsearch ----
APP_ELASTICSEARCH_HOST=localhost
APP_ELASTICSEARCH_PORT=9200
APP_ELASTICSEARCH_SCHEME=http
APP_ELASTICSEARCH_USERNAME=elastic
APP_ELASTICSEARCH_PASSWORD=changeme
APP_ELASTICSEARCH_INDEX_SNAPSHOT=snapshot_flow
APP_ELASTICSEARCH_INDEX_FEE=fee_records
APP_ELASTICSEARCH_INDEX_TRAIL=trail_fitting

# ---- 导出 ----
APP_OPTIMIZATION_EXPORT_DIR=/data/export
APP_OPTIMIZATION_SCALE_LEVEL=LEVEL_10M

# ---- 定时任务 / 消费开关 ----
APP_APP_ENV=local
APP_CONSUMER_ENABLED=true
