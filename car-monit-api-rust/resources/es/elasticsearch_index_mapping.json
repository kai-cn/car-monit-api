# ================================================================
# Elasticsearch 索引创建脚本
# 版本：7.17.0 及以上兼容
#
# 核心优化：
#   1. 使用 keyword + text 双类型存储车牌号等字段
#   2. 精确匹配走 keyword（B-tree 性能）
#   3. 模糊查询走 text（倒排索引性能）
#   4. 时间字段使用 date 类型存储，支持 range 查询
#   5. 使用 ILM 策略自动管理冷热数据（生命周期管理）
# ================================================================

# ================================================================
# 索引1：ods_rt_szdn_snapshot_flow_addcode (门架抓拍流水)
# 数据规模：日增70万条，月增2000万条
# ================================================================
PUT /ods_rt_szdn_snapshot_flow_addcode
{
  "settings": {
    "number_of_shards": 5,
    "number_of_replicas": 1,
    "refresh_interval": "5s",
    "index": {
      "max_result_window": 100000,
      "sort": {
        "field": "snapshottime",
        "order": "desc"
      }
    },
    "analysis": {
      "analyzer": {
        "plate_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": ["uppercase"]
        },
        "chinese_analyzer": {
          "type": "standard",
          "stopwords": "_chinese_"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "big_id": {
        "type": "keyword"
      },
      "datauuid": {
        "type": "keyword"
      },
      "snapshottime": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd'T'HH:mm:ss.SSSZ||epoch_millis"
      },
      "snapshottimeunix": {
        "type": "long"
      },
      "receivedtime": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss"
      },
      "gantrycode": {
        "type": "keyword"
      },
      "gantryname": {
        "type": "text",
        "analyzer": "chinese_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "roadcode": {
        "type": "keyword"
      },
      "roadname": {
        "type": "text",
        "analyzer": "chinese_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "sectioncode": {
        "type": "keyword"
      },
      "sectionname": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "tollcode": {
        "type": "keyword"
      },
      "orgcode": {
        "type": "keyword"
      },
      "orgname": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "platenumber": {
        "type": "text",
        "analyzer": "plate_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "platetypecode": {
        "type": "keyword"
      },
      "platecolor": {
        "type": "keyword"
      },
      "deviceid": {
        "type": "keyword"
      },
      "hexcode": {
        "type": "keyword"
      },
      "pileno": {
        "type": "keyword"
      },
      "lon": {
        "type": "float"
      },
      "lat": {
        "type": "float"
      },
      "direction": {
        "type": "integer"
      },
      "carbrand": {
        "type": "keyword"
      },
      "cartype": {
        "type": "keyword"
      },
      "cartypecode": {
        "type": "keyword"
      },
      "cardirection": {
        "type": "keyword"
      },
      "gradelevel": {
        "type": "integer"
      },
      "snappicturepath": {
        "type": "keyword"
      }
    }
  }
}

