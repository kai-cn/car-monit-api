# ================================================================
# ILM 策略：索引生命周期管理（冷热分离 + 自动归档）
# 数据保留策略：热(30天) -> 暖(60天) -> 冷(180天) -> 删除
# ================================================================
PUT _ilm/policy/large_data_policy
{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0d",
        "actions": {
          "rollover": {
            "max_age": "30d",
            "max_docs": 50000000
          },
          "set_priority": {
            "priority": 100
          }
        }
      },
      "warm": {
        "min_age": "30d",
        "actions": {
          "set_priority": {
            "priority": 50
          },
          "shrink": {
            "number_of_shards": 1
          },
          "forcemerge": {
            "max_num_segments": 1
          }
        }
      },
      "cold": {
        "min_age": "90d",
        "actions": {
          "set_priority": {
            "priority": 0
          },
          "freeze": {}
        }
      },
      "delete": {
        "min_age": "180d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}

# ================================================================
# 将 ILM 策略应用到三个索引
# ================================================================
PUT /ods_rt_szdn_snapshot_flow_addcode/_settings
{
  "index": {
    "lifecycle": {
      "name": "large_data_policy",
      "rollover_alias": "ods_rt_szdn_snapshot_flow_addcode"
    }
  }
}

PUT /ods_lwzxsfsj_fee_records_01/_settings
{
  "index": {
    "lifecycle": {
      "name": "large_data_policy",
      "rollover_alias": "ods_lwzxsfsj_fee_records_01"
    }
  }
}

PUT /zdata_trail_fitting/_settings
{
  "index": {
    "lifecycle": {
      "name": "large_data_policy",
      "rollover_alias": "zdata_trail_fitting"
    }
  }
}

# ================================================================
# 测试查询
# ================================================================

# 测试1：车牌号精确匹配
GET /ods_rt_szdn_snapshot_flow_addcode/_search
{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "snapshottime": {
              "gte": "2024-01-01 00:00:00",
              "lte": "2024-01-31 23:59:59",
              "format": "yyyy-MM-dd HH:mm:ss"
            }
          }
        },
        {
          "term": {
            "platenumber.keyword": "赣A12345"
          }
        }
      ]
    }
  },
  "size": 100,
  "sort": [{"snapshottime": "desc"}]
}

# 测试2：车牌模糊查询（前缀匹配）
GET /ods_rt_szdn_snapshot_flow_addcode/_search
{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "snapshottime": {
              "gte": "2024-01-01 00:00:00",
              "lte": "2024-01-31 23:59:59",
              "format": "yyyy-MM-dd HH:mm:ss"
            }
          }
        },
        {
          "prefix": {
            "platenumber.keyword": "赣A1"
          }
        }
      ]
    }
  },
  "size": 100
}

# 测试3：全模糊查询（通配符）
GET /ods_rt_szdn_snapshot_flow_addcode/_search
{
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "snapshottime": {
              "gte": "2024-01-01 00:00:00",
              "lte": "2024-01-31 23:59:59",
              "format": "yyyy-MM-dd HH:mm:ss"
            }
          }
        },
        {
          "wildcard": {
            "platenumber.keyword": "*赣A1*"
          }
        },
        {
          "term": {
            "gantrycode": "GZ001"
          }
        }
      ]
    }
  },
  "size": 100
}

