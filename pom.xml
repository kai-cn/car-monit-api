<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.ruoyi</groupId>
    <artifactId>pro-api</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <!--
      JDK 25 分支说明（car-monit-api-jdk25）：
      - 保持 javax.* 命名空间，Spring Boot 使用 2.x 最终维护版 2.7.18。
      - 本分支的 JDK 25 指「构建工具链与运行时」：CI / 本机均用 Temurin 25 构建并启动。
        字节码基线固定为 Java 21（maven.compiler.release=21），原因见下方「字节码上限」。
      - 字节码上限（实测 2026-11-11）：Spring Framework 5.3.39 内嵌 ASM 最高只识别
        class file major 65（Java 21）；spring-boot-maven-plugin 2.7.18 的 repackage
        在 major 69 上直接报 "Unsupported class file major version 69"。若需要真正的
        Java 25 字节码，必须先完成 Spring Boot 3.x / Jakarta EE 命名空间的独立迁移。
      - 使用编译器 release 选项而非 source/target；spring-kafka / spring-boot-starter-amqp
        与 Boot BOM 对齐；显式锁定 lombok 1.18.48（17/21/25 全系列可用）。
      - 在 JDK 25 上编译需要显式声明 Lombok 注解处理器（见 maven-compiler-plugin 的
        annotationProcessorPaths）；否则 @Slf4j 的 log 与 @Data 的 setter 会批量「找不到符号」。
    -->
    <properties>
        <skipTests>true</skipTests>
        <api.version>1.0</api.version>
        <!-- 语言/字节码基线 21；运行时 JDK 为 25，由 CI 与启动脚本保证 -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <druid.version>1.2.20</druid.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mysql-connector-java.version>8.0.27</mysql-connector-java.version>
        <dynamic-datasource-spring-boot-starter.version>3.4.0</dynamic-datasource-spring-boot-starter.version>
        <spring-kafka.version>2.8.11</spring-kafka.version>
        <!-- RocketMQ版本 -->
        <rocketmq.version>2.2.3</rocketmq.version>
        <!-- Elasticsearch版本 -->
        <elasticsearch.version>7.17.0</elasticsearch.version>
        <flink.version>1.13.2</flink.version>
        <pulsar-client.version>2.10.4</pulsar-client.version>
        <lombok.version>1.18.48</lombok.version>
        <!-- 覆盖 spring-boot-starter-parent 2.7.18 的 5.3.31，与 backend 保持同一安全补丁级别 -->
        <spring-framework.version>5.3.39</spring-framework.version>
    </properties>

    <modules>
        <module>pro-base-common</module>
        <module>pro-business-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 通用工具-->
            <dependency>
                <groupId>com.ruoyi</groupId>
                <artifactId>pro-base-common</artifactId>
                <version>${api.version}</version>
            </dependency>
            <!-- Lombok 1.18.48 支持 JDK 17 / 21 / 25 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <!-- ==================== Flink 依赖 ==================== -->
            <!-- Flink Core + Java API -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-java</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <!-- Flink Streaming Java（Scala 2.11 版本） -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-streaming-java_2.11</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <!-- Flink 客户端（用于 StreamExecutionEnvironment.getExecutionEnvironment） -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-clients_2.11</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <!-- Flink Kafka Connector（FlinkKafkaConsumer 所在依赖） -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-connector-kafka_2.11</artifactId>
                <version>${flink.version}</version>
            </dependency>
            <!-- Flink 状态后端（用于 TTL 状态管理，1.13 已合并到 core，但显式声明更保险） -->
            <dependency>
                <groupId>org.apache.flink</groupId>
                <artifactId>flink-runtime_2.11</artifactId>
                <version>${flink.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.pulsar</groupId>
                <artifactId>pulsar-client</artifactId>
                <version>${pulsar-client.version}</version>
            </dependency>

            <!-- Spring Kafka -->
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>${spring-kafka.version}</version>
            </dependency>
            <!-- RocketMQ Spring Boot Starter -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <!-- RabbitMQ Starter 由 Boot 2.7.18 parent BOM 直接管理版本，
                 此处不再声明（当前 POM 的无版本条目会遮蔽 parent 的版本管理）。 -->
            <!-- Elasticsearch High Level REST Client -->
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-high-level-client</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
            <!-- Elasticsearch Core -->
            <dependency>
                <groupId>org.elasticsearch</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${elasticsearch.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <parameters>true</parameters>
                    <!-- 显式声明 Lombok 为注解处理器：JDK 25 下 classpath 自动发现
                         处理器会失败，导致 Lombok 生成符号缺失 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                    <include>**/*.json</include>
                    <include>**/*.ftl</include>
                    <include>**/*.xls</include>
                </includes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
