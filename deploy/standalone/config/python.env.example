# Python 单机部署环境变量模板（全部为占位符）
# 生产必须 CAR_MONIT_RUNTIME=prod；本地/验证可用 shim（仅内存替身）。
CAR_MONIT_RUNTIME=prod
CAR_MONIT_HOST=0.0.0.0
CAR_MONIT_PORT=9901

# 数据库（GaussDB/PostgreSQL 协议）
SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_USERNAME=<DB_USER>
SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_PASSWORD=<DB_PASSWORD>

# 中间件
CAR_MONIT_REDIS_URL=redis://<REDIS_HOST>:6379/0
CAR_MONIT_ES_URL=http://<ES_HOST>:9200
CAR_MONIT_KAFKA_URL=<KAFKA_HOST>:9092
