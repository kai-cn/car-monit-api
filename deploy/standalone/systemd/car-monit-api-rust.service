[Unit]
Description=car-monit-api (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PREFIX@/rust
ExecStart=@PREFIX@/rust/car-monit-api-rust --config @PREFIX@/rust/config/application.yaml
Restart=always
RestartSec=10
LimitNOFILE=65535
StandardOutput=append:@LOG_DIR@/rust/stdout.log
StandardError=append:@LOG_DIR@/rust/stderr.log

[Install]
WantedBy=multi-user.target
