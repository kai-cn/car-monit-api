<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.modules.mapper.EcBillingStatementMapper">

    <resultMap type="com.ruoyi.modules.entity.EcBillingStatement" id="EcBillingStatementResult">
        <result property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="storeId" column="store_id"/>
        <result property="storeName" column="store_name"/>
        <result property="accountId" column="account_id"/>
        <result property="accountName" column="account_name"/>
        <result property="costType" column="cost_type"/>
        <result property="costMoney" column="cost_money"/>
        <result property="bussType" column="buss_type"/>
        <result property="remark" column="remark"/>
        <result property="backCol1" column="back_col1"/>
        <result property="backCol2" column="back_col2"/>
        <result property="kfType" column="kf_type"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="epsId" column="eps_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="tenantId" column="tenant_id"/>

    </resultMap>

    <sql id="selectEcBillingStatementVo">
         t.id,
         t.order_id,
         t.store_id,
         t.store_name,
         t.account_id,
         t.account_name,
         t.cost_type,
         t.cost_money,
         t.buss_type,
         t.remark,
         t.back_col1,
         t.back_col2,
         t.kf_type,
         t.status,
         t.sort,
         t.eps_id,
         t.del_flag,
         t.create_by,
         t.create_time,
         t.update_by,
         t.update_time,
         t.tenant_id
    </sql>


    <select id="selectEcBillingStatementList" parameterType="com.ruoyi.modules.entity.EcBillingStatement" resultMap="EcBillingStatementResult">
        SELECT
        <include refid="selectEcBillingStatementVo"/>
        FROM ec_billing_statement t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''">and t.id = #{id}</if>
        <if test="orderId != null  and orderId != ''">and t.order_id = #{orderId}</if>
        <if test="storeId != null  and storeId != ''">and t.store_id = #{storeId}</if>
        <if test="storeName != null  and storeName != ''">and t.store_name like concat('%', #{storeName}, '%')</if>
        <if test="accountId != null  and accountId != ''">and t.account_id = #{accountId}</if>
        <if test="accountName != null  and accountName != ''">and t.account_name like concat('%', #{accountName}, '%')
        </if>
        <if test="costType != null  and costType != ''">and t.cost_type = #{costType}</if>
        <if test="costMoney != null ">and t.cost_money = #{costMoney}</if>
        <if test="bussType != null  and bussType != ''">and t.buss_type = #{bussType}</if>
        <if test="backCol1 != null  and backCol1 != ''">and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''">and t.back_col2 = #{backCol2}</if>
        <if test="kfType != null  and kfType != ''">and t.kf_type = #{kfType}</if>
        <if test="status != null  and status != ''">and t.status = #{status}</if>
        <if test="sort != null ">and t.sort = #{sort}</if>
        <if test="epsId != null ">and t.eps_id = #{epsId}</if>
        <if test="tenantId != null ">and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null ">
           and (t.create_by = #{createBy} or find_in_set(t.store_id,#{myShopIds}) > 0)
        </if>
        <if test="startTime != null  and startTime != ''">and t.create_time >= STR_TO_DATE(#{startTime},'%Y-%m-%d')</if>
        <if test="endTime != null  and endTime != ''">and t.create_time <![CDATA[<]]>date_add(STR_TO_DATE(#{endTime},'%Y-%m-%d'), interval 1 day)</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectEcBillingStatementById" parameterType="String" resultMap="EcBillingStatementResult">
        select
        <include refid="selectEcBillingStatementVo"/>
        from ec_billing_statement t
        where t.id = #{id}
    </select>

    <insert id="insertEcBillingStatement" parameterType="com.ruoyi.modules.entity.EcBillingStatement">
        insert into ec_billing_statement
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="storeId != null">store_id,</if>
            <if test="storeName != null">store_name,</if>
            <if test="accountId != null">account_id,</if>
            <if test="accountName != null">account_name,</if>
            <if test="costType != null">cost_type,</if>
            <if test="costMoney != null">cost_money,</if>
            <if test="bussType != null">buss_type,</if>
            <if test="remark != null">remark,</if>
            <if test="backCol1 != null">back_col1,</if>
            <if test="backCol2 != null">back_col2,</if>
            <if test="kfType != null">kf_type,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
            <if test="epsId != null">eps_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="storeId != null">#{storeId},</if>
            <if test="storeName != null">#{storeName},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="accountName != null">#{accountName},</if>
            <if test="costType != null">#{costType},</if>
            <if test="costMoney != null">#{costMoney},</if>
            <if test="bussType != null">#{bussType},</if>
            <if test="remark != null">#{remark},</if>
            <if test="backCol1 != null">#{backCol1},</if>
            <if test="backCol2 != null">#{backCol2},</if>
            <if test="kfType != null">#{kfType},</if>
            <if test="status != null">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="epsId != null">#{epsId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
        </trim>
    </insert>

    <update id="updateEcBillingStatement" parameterType="com.ruoyi.modules.entity.EcBillingStatement">
        update ec_billing_statement
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="storeName != null">store_name = #{storeName},</if>
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="accountName != null">account_name = #{accountName},</if>
            <if test="costType != null">cost_type = #{costType},</if>
            <if test="costMoney != null">cost_money = #{costMoney},</if>
            <if test="bussType != null">buss_type = #{bussType},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="backCol1 != null">back_col1 = #{backCol1},</if>
            <if test="backCol2 != null">back_col2 = #{backCol2},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteEcBillingStatementById" parameterType="String">
        update ec_billing_statement set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteEcBillingStatementByIds" parameterType="String">
        update ec_billing_statement set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>


</mapper>
