<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.modules.mapper.EcCostSzMapper">

    <resultMap type="com.ruoyi.modules.entity.EcCostSz" id="EcCostSzResult">
        <result property="id" column="id"/>
        <result property="bussType" column="buss_type"/>
        <result property="costType" column="cost_type"/>
        <result property="costMoney" column="cost_money"/>
        <result property="beginRange"    column="begin_range"    />
        <result property="endRange"    column="end_range"    />
        <result property="otherParas"    column="other_paras"    />
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="backCol1" column="back_col1"/>
        <result property="backCol2" column="back_col2"/>
        <result property="sort" column="sort"/>
        <result property="epsId" column="eps_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="tenantId" column="tenant_id"/>
    </resultMap>

    <sql id="selectEcCostSzVo">
         t.id,
         t.buss_type,
         t.cost_type,
         t.cost_money,
         t.begin_range,
         t.end_range,
         t.other_paras,
         t.remark,
         t.status,
         t.back_col1,
         t.back_col2,
         t.sort,
         t.eps_id,
         t.del_flag,
         t.create_by,
         t.create_time,
         t.update_by,
         t.update_time,
         t.tenant_id
    </sql>


    <select id="selectEcCostSzList" parameterType="com.ruoyi.modules.entity.EcCostSz" resultMap="EcCostSzResult">
        SELECT
        <include refid="selectEcCostSzVo"/>
        FROM ec_cost_sz t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''">and t.id = #{id}</if>
        <if test="bussType != null  and bussType != ''">and t.buss_type = #{bussType}</if>
        <if test="costType != null  and costType != ''">and t.cost_type = #{costType}</if>
        <if test="costMoney != null ">and t.cost_money = #{costMoney}</if>
        <if test="status != null  and status != ''">and t.status = #{status}</if>
        <if test="backCol1 != null  and backCol1 != ''">and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''">and t.back_col2 = #{backCol2}</if>
        <if test="sort != null ">and t.sort = #{sort}</if>
        <if test="epsId != null ">and t.eps_id = #{epsId}</if>
        <if test="tenantId != null ">and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null ">and t.create_by = #{createBy}</if>
        order by t.create_time,t.id
    </select>

    <select id="selectEcCostSzById" parameterType="String" resultMap="EcCostSzResult">
        select
        <include refid="selectEcCostSzVo"/>
        from ec_cost_sz t
        where t.id = #{id}
    </select>

    <insert id="insertEcCostSz" parameterType="com.ruoyi.modules.entity.EcCostSz">
        insert into ec_cost_sz
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="bussType != null">buss_type,</if>
            <if test="costType != null">cost_type,</if>
            <if test="costMoney != null">cost_money,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
            <if test="backCol1 != null">back_col1,</if>
            <if test="backCol2 != null">back_col2,</if>
            <if test="sort != null">sort,</if>
            <if test="epsId != null">eps_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="tenantId != null">tenant_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="bussType != null">#{bussType},</if>
            <if test="costType != null">#{costType},</if>
            <if test="costMoney != null">#{costMoney},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
            <if test="backCol1 != null">#{backCol1},</if>
            <if test="backCol2 != null">#{backCol2},</if>
            <if test="sort != null">#{sort},</if>
            <if test="epsId != null">#{epsId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
        </trim>
    </insert>

    <update id="updateEcCostSz" parameterType="com.ruoyi.modules.entity.EcCostSz">
        update ec_cost_sz
        <trim prefix="SET" suffixOverrides=",">
            <if test="bussType != null">buss_type = #{bussType},</if>
            <if test="costType != null">cost_type = #{costType},</if>
            <if test="costMoney != null">cost_money = #{costMoney},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="backCol1 != null">back_col1 = #{backCol1},</if>
            <if test="backCol2 != null">back_col2 = #{backCol2},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteEcCostSzById" parameterType="String">
        update ec_cost_sz set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteEcCostSzByIds" parameterType="String">
        update ec_cost_sz set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="isExists" parameterType="com.ruoyi.modules.entity.EcCostSz" resultType="java.lang.Integer">
        select count(1) from ec_cost_sz t
        where t.del_flag = '0'  and t.cost_type = #{costType}
        <if test="id != null  and id != ''"> and t.id != #{id}</if>
    </select>

</mapper>
