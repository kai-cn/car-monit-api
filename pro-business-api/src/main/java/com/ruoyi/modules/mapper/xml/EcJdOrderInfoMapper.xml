        <if test="feeType != null  and feeType != ''">and t.fee_type = #{feeType}</if>
        <if test="paymentType != null  and paymentType != ''">and t.payment_type = #{paymentType}</if>
        <if test="paymentTypeName != null  and paymentTypeName != ''">and t.payment_type_name like concat('%',
            #{paymentTypeName}, '%')
        </if>
        <if test="orderCreateTime != null ">and t.order_create_time = #{orderCreateTime}</if>
        <if test="orderCompleteTime != null ">and t.order_complete_time = #{orderCompleteTime}</if>
        <if test="paymentConfirmTime != null ">and t.payment_confirm_time = #{paymentConfirmTime}</if>
        <if test="storeId != null  and storeId != ''">and t.store_id = #{storeId}</if>
        <if test="storeName != null  and storeName != ''">and t.store_name like concat('%', #{storeName}, '%')</if>
        <if test="shouldPay != null ">and t.should_pay = #{shouldPay}</if>
        <if test="receivables != null ">and t.receivables = #{receivables}</if>
        <if test="freight != null ">and t.freight = #{freight}</if>
        <if test="userPin != null  and userPin != ''">and t.user_pin = #{userPin}</if>
        <if test="consName != null  and consName != ''">and t.cons_name like concat('%', #{consName}, '%')</if>
