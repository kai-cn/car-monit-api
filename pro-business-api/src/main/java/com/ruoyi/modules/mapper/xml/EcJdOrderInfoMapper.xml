        <include refid="selectEcJdOrderInfoVo"/>
        FROM ec_jd_order_info t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''">and t.id = #{id}</if>
        <if test="orderType != null  and orderType != ''">and t.order_type = #{orderType}</if>
        <if test="mendianId != null  and mendianId != ''">and t.mendian_id = #{mendianId}</if>
