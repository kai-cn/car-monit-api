        t.tenant_id
    </sql>


    <select id="selectEcCostSzDetailList" parameterType="com.ruoyi.modules.entity.EcCostSzDetail" resultMap="EcCostSzDetailResult">
        SELECT
        <include refid="selectEcCostSzDetailVo"/>
        FROM ec_cost_sz_detail t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''">and t.id = #{id}</if>
        <if test="costSzId != null  and costSzId != ''">and t.cost_sz_id = #{costSzId}</if>
        <if test="beginRange != null ">and t.begin_range = #{beginRange}</if>
        <if test="endRange != null ">and t.end_range = #{endRange}</if>
        <if test="otherParas != null  and otherParas != ''">and t.other_paras = #{otherParas}</if>
        <if test="costMoney != null ">and t.cost_money = #{costMoney}</if>
        <if test="status != null  and status != ''">and t.status = #{status}</if>
        <if test="backCol1 != null  and backCol1 != ''">and t.back_col1 = #{backCol1}</if>
        <if test="backCol2 != null  and backCol2 != ''">and t.back_col2 = #{backCol2}</if>
        <if test="sort != null ">and t.sort = #{sort}</if>
        <if test="epsId != null ">and t.eps_id = #{epsId}</if>
        <if test="tenantId != null ">and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null ">and t.create_by = #{createBy}</if>
        <if test="queryRange != null ">and  #{queryRange} >= t.begin_range  and #{queryRange} <![CDATA[ <= ]]> t.end_range </if>
        order by t.create_time,t.id
    </select>

    <select id="selectEcCostSzDetailById" parameterType="String" resultMap="EcCostSzDetailResult">
        select
        <include refid="selectEcCostSzDetailVo"/>
        from ec_cost_sz_detail t
        where t.id = #{id}
