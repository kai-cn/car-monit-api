    <update id="updateEcCostSzDetail" parameterType="com.ruoyi.modules.entity.EcCostSzDetail">
        update ec_cost_sz_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="costSzId != null">cost_sz_id = #{costSzId},</if>
            <if test="beginRange != null">begin_range = #{beginRange},</if>
            <if test="endRange != null">end_range = #{endRange},</if>
