<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.modules.mapper.EcCostSzDetailMapper">

    <resultMap type="com.ruoyi.modules.entity.EcCostSzDetail" id="EcCostSzDetailResult">
        <result property="id" column="id"/>
        <result property="costSzId" column="cost_sz_id"/>
