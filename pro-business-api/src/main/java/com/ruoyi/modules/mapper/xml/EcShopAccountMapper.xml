<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.modules.mapper.EcShopAccountMapper">

    <resultMap type="com.ruoyi.modules.entity.EcShopAccount" id="EcShopAccountResult">
        <result property="id" column="id"/>
        <result property="account" column="account"/>
        <result property="accountPassword" column="account_password"/>
        <result property="totalMoney" column="total_money"/>
        <result property="czTotalMoney" column="cz_total_money"/>
        <result property="storeIds" column="store_ids"/>
        <result property="storeNames" column="store_names"/>
        <result property="remark" column="remark"/>
        <result property="backCol1" column="back_col1"/>
        <result property="backCol2" column="back_col2"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="epsId" column="eps_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="tenantId" column="tenant_id"/>

    </resultMap>

    <sql id="selectEcShopAccountVo">
        t.id,
        t.account,
        t.account_password,
        t.total_money,
        t.cz_total_money,
        t.store_ids,
        t.store_names,
        t.remark,
        t.back_col1,
        t.back_col2,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>

    <select id="selectEcShopAccountById" parameterType="String" resultMap="EcShopAccountResult">
        select
        <include refid="selectEcShopAccountVo"/>
        from ec_shop_account t
        where t.id = #{id}
    </select>

    <update id="updateEcShopAccountMonery" parameterType="com.ruoyi.modules.entity.EcShopAccount">
        update ec_shop_account
        <trim prefix="SET" suffixOverrides=",">
            <if test="totalMoney != null">total_money = #{totalMoney},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>


</mapper>
