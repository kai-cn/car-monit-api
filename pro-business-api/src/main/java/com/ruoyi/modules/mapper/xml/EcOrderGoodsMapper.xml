            <if test="tenantId != null">#{tenantId},</if>
        </trim>
    </insert>

    <update id="updateEcOrderGoods" parameterType="com.ruoyi.modules.entity.EcOrderGoods">
        update ec_order_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="platformId != null">platform_id = #{platformId},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
            <if test="shopName != null">shop_name = #{shopName},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="skuName != null">sku_name = #{skuName},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="skuId != null">sku_id = #{skuId},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="num != null">num = #{num},</if>
            <if test="jdPrice != null">jd_price = #{jdPrice},</if>
            <if test="color != null">color = #{color},</if>
            <if test="imgUrl != null">img_url = #{imgUrl},</if>
            <if test="skuUrl != null">sku_url = #{skuUrl},</if>
            <if test="skuUuid != null">sku_uuid = #{skuUuid},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
