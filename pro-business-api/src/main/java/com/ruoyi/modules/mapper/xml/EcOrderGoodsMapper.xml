<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.modules.mapper.EcOrderGoodsMapper">

    <resultMap type="com.ruoyi.modules.entity.EcOrderGoods" id="EcOrderGoodsResult">
        <result property="id" column="id"/>
        <result property="platformId" column="platform_id"/>
        <result property="shopId" column="shop_id"/>
        <result property="shopName" column="shop_name"/>
        <result property="orderId" column="order_id"/>
        <result property="skuName" column="sku_name"/>
        <result property="productId" column="product_id"/>
        <result property="skuId" column="sku_id"/>
        <result property="itemId" column="item_id"/>
        <result property="num" column="num"/>
        <result property="jdPrice" column="jd_price"/>
        <result property="color" column="color"/>
        <result property="imgUrl" column="img_url"/>
        <result property="skuUrl" column="sku_url"/>
        <result property="skuUuid" column="sku_uuid"/>
        <result property="categoryId" column="category_id"/>
        <result property="remark" column="remark"/>
        <result property="status" column="status"/>
        <result property="sort" column="sort"/>
        <result property="epsId" column="eps_id"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="tenantId" column="tenant_id"/>

    </resultMap>

    <sql id="selectEcOrderGoodsVo">
        t.id,
        t.platform_id,
        t.shop_id,
        t.shop_name,
        t.order_id,
        t.sku_name,
        t.product_id,
        t.sku_id,
        t.item_id,
        t.num,
        t.jd_price,
        t.color,
        t.img_url,
        t.sku_url,
        t.sku_uuid,
        t.category_id,
        t.remark,
        t.status,
        t.sort,
        t.eps_id,
        t.del_flag,
        t.create_by,
        t.create_time,
        t.update_by,
        t.update_time,
        t.tenant_id
    </sql>


    <select id="selectEcOrderGoodsList" parameterType="com.ruoyi.modules.entity.EcOrderGoods"
            resultMap="EcOrderGoodsResult">
        SELECT
        <include refid="selectEcOrderGoodsVo"/>
        FROM ec_order_goods t
        WHERE t.del_flag = '0'
        <if test="id != null  and id != ''">and t.id = #{id}</if>
        <if test="platformId != null  and platformId != ''">and t.platform_id = #{platformId}</if>
        <if test="shopId != null  and shopId != ''">and t.shop_id = #{shopId}</if>
        <if test="shopName != null  and shopName != ''">and t.shop_name like concat('%', #{shopName}, '%')</if>
        <if test="orderId != null  and orderId != ''">and t.order_id = #{orderId}</if>
        <if test="skuName != null  and skuName != ''">and t.sku_name like concat('%', #{skuName}, '%')</if>
        <if test="productId != null  and productId != ''">and t.product_id = #{productId}</if>
        <if test="skuId != null  and skuId != ''">and t.sku_id = #{skuId}</if>
        <if test="itemId != null  and itemId != ''">and t.item_id = #{itemId}</if>
        <if test="num != null ">and t.num = #{num}</if>
        <if test="jdPrice != null ">and t.jd_price = #{jdPrice}</if>
        <if test="color != null  and color != ''">and t.color = #{color}</if>
        <if test="imgUrl != null  and imgUrl != ''">and t.img_url = #{imgUrl}</if>
        <if test="skuUrl != null  and skuUrl != ''">and t.sku_url = #{skuUrl}</if>
        <if test="skuUuid != null  and skuUuid != ''">and t.sku_uuid = #{skuUuid}</if>
        <if test="categoryId != null  and categoryId != ''">and t.category_id = #{categoryId}</if>
        <if test="status != null  and status != ''">and t.status = #{status}</if>
        <if test="sort != null ">and t.sort = #{sort}</if>
        <if test="epsId != null ">and t.eps_id = #{epsId}</if>
        <if test="tenantId != null ">and t.tenant_id = #{tenantId}</if>
        <if test="createBy != null ">and t.create_by = #{createBy}</if>
        order by t.create_time desc,t.id
    </select>

    <select id="selectEcOrderGoodsById" parameterType="String" resultMap="EcOrderGoodsResult">
        select
        <include refid="selectEcOrderGoodsVo"/>
        from ec_order_goods t
        where t.id = #{id}
    </select>

    <insert id="insertEcOrderGoods" parameterType="com.ruoyi.modules.entity.EcOrderGoods">
