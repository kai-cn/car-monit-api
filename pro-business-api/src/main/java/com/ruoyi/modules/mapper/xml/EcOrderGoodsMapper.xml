    </update>

    <update id="deleteEcOrderGoodsById" parameterType="String">
        update ec_order_goods
        set del_flag = '1'
        where id = #{id}
    </update>

    <update id="deleteEcOrderGoodsByIds" parameterType="String">
        update ec_order_goods set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="deleteEcOrderGoodsByOrderId" parameterType="String">
        delete
        from ec_order_goods
        where order_id = #{orderId}
    </delete>
</mapper>
