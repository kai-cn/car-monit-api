<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.base.mapper.OdsLwzxsfsjFeeRecords01Mapper">

    <!--
        游标分页（Keyset Pagination）查询：用于收费流水大规模同步到 ES
        Keyset pagination for fee-records large-scale sync to ES.

        设计要点 / Design notes (与门架抓拍流水一致):
        1) 强依赖 (transtime, big_id) 联合索引（GaussDB/PostgreSQL）
           Relies on a composite index on (transtime, big_id)
        2) 首次调用 cursorTime/cursorUuid 为 null；后续用上一批最后一条推进
           First call passes null cursors; subsequent batches advance by last row
        3) 使用 ORDER BY + LIMIT，无需扫描 OFFSET 之前的全部记录（复杂度 O(total)）
           ORDER BY + LIMIT avoids O(offset) deep pagination
        4) SELECT t.* 配合 mapUnderscoreToCamelCase 自动映射到领域对象
           SELECT t.* with auto-mapping populates the domain object
    -->
    <select id="selectByCursorShard" resultType="com.ruoyi.base.domain.OdsLwzxsfsjFeeRecords01">
        SELECT t.*
        FROM jl_data01.ods_lwzxsfsj_fee_records_01 t
        <where>
            and t.transtime >= to_timestamp(#{startTime},'yyyy-mm-dd HH24:MI:SS')
            and t.transtime <![CDATA[<]]> to_timestamp(#{endTime},'yyyy-mm-dd HH24:MI:SS')
            <if test="cursorTime != null and cursorTime != ''">
                and (
                     t.transtime > to_timestamp(#{cursorTime},'yyyy-mm-dd HH24:MI:SS')
                     or (
                         t.transtime = to_timestamp(#{cursorTime},'yyyy-mm-dd HH24:MI:SS')
                         <if test="cursorUuid != null and cursorUuid != ''">
                             and t.big_id > #{cursorUuid}
                         </if>
                     )
                )
            </if>
        </where>
        ORDER BY t.transtime ASC, t.big_id ASC
        LIMIT #{limit}
    </select>

</mapper>
